# AEGIS local configuration
# Copy to .env.local. Never commit real credentials or vault paths.

# OpenAI-compatible gateway. The URL should end at the provider's /v1 path.
AEGIS_LLM_BASE_URL=
AEGIS_LLM_API_KEY=

# Route-specific model IDs. Discover the live catalog for your provider.
AEGIS_MODEL_FAST=
AEGIS_MODEL_BALANCED=
AEGIS_MODEL_REASONING=
AEGIS_MODEL_LONG_CONTEXT=
AEGIS_LLM_TIMEOUT_MS=30000

# Local Obsidian boundary. Keep outside Git and use an absolute path.
OBSIDIAN_VAULT_PATH=
OBSIDIAN_CAPTURE_FOLDER=00 Inbox
OBSIDIAN_DAILY_FOLDER=Daily
OBSIDIAN_PROJECT_FOLDER=Projects
OBSIDIAN_TASK_FOLDER=Tasks
